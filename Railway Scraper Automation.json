                            "name": "Task ID",
                            "value": "={{ $json.summary.task_id }}",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Format Stop Output",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                680,
                1620
            ]
        },
