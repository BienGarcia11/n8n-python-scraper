                            "id": "6-3",
                            "name": "Message",
                            "value": "={{ $json.message }}",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Format Status Reset Output",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                900,
                1280
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://n8n-python-scraper-production.up.railway.app/scrape/bulk/stop",
                "options": {}
            },
            "name": "Stop Bulk Scrape",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                460,
                1620
            ],
            "notesInFlow": true,
            "notes": "POST /scrape/bulk/stop\n\nStops currently running bulk scrape:\n- Marks task as cancelled\n- Completes current batch before stopping\n- Returns summary of progress\n- URLs in 'processing' status will remain\n\nUse when: Emergency stop needed"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "7-1",
