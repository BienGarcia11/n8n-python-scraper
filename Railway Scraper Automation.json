{
    "name": "Railway Scraper Automation - Manual Control",
    "nodes": [
        {
            "parameters": {},
            "name": "Manual Trigger",
            "type": "n8n-nodes-base.manualTrigger",
            "typeVersion": 1,
            "position": [
                240,
                300
            ],
            "notesInFlow": true,
            "notes": "🎯 Manual Trigger\n\nClick to execute workflow\nSelect which operation to run:\n- Click on any HTTP Request node below\n- View results from Format node"
        },
        {
            "parameters": {
                "method": "GET",
                "url": "https://n8n-python-scraper-production.up.railway.app/scrape/bulk/status",
                "options": {}
            },
            "name": "Check Bulk Status",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                460,
                300
            ],
            "notesInFlow": true,
            "notes": "📊 GET /scrape/bulk/status\n\nChecks current bulk scrape status\n\nReturns:\n- running: true/false\n- task_id: Unique ID\n- progress: Percentage\n- processed: Count\n- failed: Count\n\nUse when: Monitoring ongoing scrape jobs"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "1-1",
                            "name": "Status",
                            "value": "={{ $json.running ? 'Running' : 'Not Running' }}",
                            "type": "string"
                        },
                        {
                            "id": "1-2",
                            "name": "Task ID",
                            "value": "={{ $json.task_id || 'N/A' }}",
                            "type": "string"
                        },
                        {
                            "id": "1-3",
                            "name": "Progress",
                            "value": "={{ $json.progress || 0 }}%",
                            "type": "string"
                        },
                        {
                            "id": "1-4",
                            "name": "Processed",
                            "value": "={{ $json.processed || 0 }}",
                            "type": "number"
                        },
                        {
                            "id": "1-5",
                            "name": "Failed",
                            "value": "={{ $json.failed || 0 }}",
                            "type": "number"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Format Status Output",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                680,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://n8n-python-scraper-production.up.railway.app/scrape/bulk",
                "options": {}
            },
            "name": "Start Bulk Scrape",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                460,
                620
            ],
            "notesInFlow": true,
            "notes": "🚀 POST /scrape/bulk\n\nStarts automated bulk scraping\n\nReturns:\n- task_id: Unique ID\n- status: started/running\n- pending_count: Number of URLs\n\nSafety limit: 100 URLs per run\nBatches of 3 URLs\n\nUse when: Ready to scrape pending URLs"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "2-1",
                            "name": "Task ID",
                            "value": "={{ $json.task_id }}",
                            "type": "string"
                        },
                        {
                            "id": "2-2",
                            "name": "Status",
                            "value": "={{ $json.status }}",
                            "type": "string"
                        },
                        {
                            "id": "2-3",
                            "name": "URLs to Process",
                            "value": "={{ $json.pending_count }}",
                            "type": "number"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Format Start Output",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                680,
                620
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://n8n-python-scraper-production.up.railway.app/scrape/bulk/reset",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "{\"reset_all\": false, \"days_threshold\": 14}",
                "options": {}
            },
            "name": "Reset by Age (14 Days)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                460,
                940
            ],
            "notesInFlow": true,
            "notes": "🔄 POST /scrape/bulk/reset\n\nResets URLs older than 14 days\n\nBody:\n{\"reset_all\": false, \"days_threshold\": 14}\n\nReturns:\n- reset_count: URLs reset\n- message: Result message\n\nChange days_threshold in node settings\n\nUse when: Scheduled 2-week refresh"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "4-1",
                            "name": "Action",
                            "value": "Reset URLs Older Than 14 Days",
                            "type": "string"
                        },
                        {
                            "id": "4-2",
                            "name": "URLs Reset",
                            "value": "={{ $json.reset_count }}",
                            "type": "number"
                        },
                        {
                            "id": "4-3",
                            "name": "Message",
                            "value": "={{ $json.message }}",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Format Reset Output",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                900,
                940
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://n8n-python-scraper-production.up.railway.app/scrape/bulk/reset",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "{\"reset_all\": false, \"status\": \"completed\"}",
                "options": {}
            },
            "name": "Reset Completed URLs",
            "type": "n8n-nodes-base.httpRequest",
