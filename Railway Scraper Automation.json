{
    "name": "Railway Scraper Automation - Manual Control",
    "nodes": [
        {
            "parameters": {},
            "name": "Manual Trigger",
            "type": "n8n-nodes-base.manualTrigger",
            "typeVersion": 1,
            "position": [
                240,
                300
            ],
            "notesInFlow": true,
            "notes": "Click to manually trigger automation\nSelect which action to run below"
        },
        {
            "parameters": {},
            "name": "Sticky Note - Status Check",
            "type": "n8n-nodes-base.stickyNote",
            "typeVersion": 1,
            "position": [
                460,
                100
            ],
            "width": 300,
            "height": 120,
            "notes": "# 📊 Status Check\n\nChecks current bulk scrape status:\n- Running state\n- Task ID\n- Progress percentage\n- Success/failure counts\n\nUse when: Monitoring ongoing scrape jobs"
        },
        {
            "parameters": {
                "method": "GET",
                "url": "https://n8n-python-scraper-production.up.railway.app/scrape/bulk/status",
                "options": {}
            },
            "name": "Check Bulk Status",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                460,
                300
            ],
            "notesInFlow": true,
            "notes": "GET /scrape/bulk/status\n\nChecks current bulk scrape status:\n- Running state (true/false)\n- Task ID\n- Progress percentage\n- Processed count\n- Failed count\n\nUse when: Monitoring ongoing scrape jobs"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "1-1",
                            "name": "Status",
                            "value": "={{ $json.running ? 'Running' : 'Not Running' }}",
                            "type": "string"
                        },
                        {
                            "id": "1-2",
                            "name": "Task ID",
                            "value": "={{ $json.task_id || 'N/A' }}",
                            "type": "string"
                        },
                        {
                            "id": "1-3",
                            "name": "Progress",
                            "value": "={{ $json.progress || 0 }}%",
                            "type": "string"
                        },
                        {
                            "id": "1-4",
                            "name": "Processed",
                            "value": "={{ $json.processed || 0 }}",
                            "type": "number"
                        },
                        {
                            "id": "1-5",
                            "name": "Failed",
                            "value": "={{ $json.failed || 0 }}",
                            "type": "number"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Format Status Output",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                680,
                300
            ]
        },
        {
            "parameters": {},
            "name": "Sticky Note - Start Bulk Scrape",
            "type": "n8n-nodes-base.stickyNote",
            "typeVersion": 1,
            "position": [
                460,
                440
            ],
            "width": 300,
            "height": 120,
            "notes": "# 🚀 Start Bulk Scrape\n\nStarts automated bulk scraping:\n- Fetches all pending URLs\n- Processes in batches of 3\n- Generates embeddings\n- Updates documents table\n\nSafety limit: 100 URLs per run"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://n8n-python-scraper-production.up.railway.app/scrape/bulk",
                "options": {}
            },
            "name": "Start Bulk Scrape",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                460,
                620
            ],
            "notesInFlow": true,
            "notes": "POST /scrape/bulk\n\nStarts automated bulk scraping:\n- Fetches all pending URLs from database\n- Processes in batches of 3 URLs\n- Generates OpenAI embeddings\n- Updates documents table\n- Safety limit: 100 URLs per run\n\nUse when: Ready to scrape pending URLs"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "2-1",
                            "name": "Task ID",
                            "value": "={{ $json.task_id }}",
                            "type": "string"
                        },
                        {
                            "id": "2-2",
                            "name": "Status",
                            "value": "={{ $json.status }}",
                            "type": "string"
                        },
                        {
                            "id": "2-3",
                            "name": "URLs to Process",
                            "value": "={{ $json.pending_count }}",
                            "type": "number"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Format Start Output",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                680,
                620
            ]
        },
        {
            "parameters": {},
            "name": "Sticky Note - Reset by Age",
            "type": "n8n-nodes-base.stickyNote",
            "typeVersion": 1,
            "position": [
                460,
                760
            ],
            "width": 300,
            "height": 120,
            "notes": "# 🔄 Reset URLs by Age\n\nResets URLs older than X days:\n- Default: 14 days\n- Changes status to 'pending'\n- Enables re-scraping old content\n\nUse when: Scheduled 2-week refresh cycle"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "3-1",
                            "name": "reset_all",
                            "value": false,
                            "type": "boolean"
                        },
                        {
                            "id": "3-2",
                            "name": "days_threshold",
                            "value": 14,
                            "type": "number"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Set Reset Age Parameters",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                460,
                940
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://n8n-python-scraper-production.up.railway.app/scrape/bulk/reset",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { \"reset_all\": $json.reset_all, \"days_threshold\": $json.days_threshold } }}",
                "options": {}
            },
            "name": "Reset by Age (14 Days)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                680,
                940
            ],
            "notesInFlow": true,
            "notes": "POST /scrape/bulk/reset\n\nResets URLs older than X days to 'pending':\n- Body: {\"reset_all\": false, \"days_threshold\": 14}\n- Default: 14 days threshold\n- Changes status from completed/failed/processing to pending\n- Enables re-scraping old content\n\nUse when: Scheduled 2-week refresh cycle"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "4-1",
                            "name": "Action",
                            "value": "Reset URLs Older Than 14 Days",
                            "type": "string"
                        },
                        {
                            "id": "4-2",
                            "name": "URLs Reset",
                            "value": "={{ $json.reset_count }}",
                            "type": "number"
                        },
                        {
                            "id": "4-3",
                            "name": "Message",
                            "value": "={{ $json.message }}",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Format Reset Output",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                900,
                940
            ]
        },
        {
            "parameters": {},
            "name": "Sticky Note - Reset by Status",
            "type": "n8n-nodes-base.stickyNote",
            "typeVersion": 1,
            "position": [
                460,
                1080
            ],
            "width": 300,
            "height": 140,
            "notes": "# 🔄 Reset URLs by Status\n\nResets specific URL statuses:\n- 'completed' - Re-scrape successful URLs\n- 'failed' - Retry failed URLs\n- 'processing' - Clear stuck URLs\n\nUse when: Selective re-scraping needed"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "5-1",
                            "name": "reset_all",
                            "value": false,
                            "type": "boolean"
                        },
                        {
                            "id": "5-2",
                            "name": "status",
                            "value": "completed",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Set Reset Status Parameters",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                460,
                1280
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://n8n-python-scraper-production.up.railway.app/scrape/bulk/reset",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ { \"reset_all\": $json.reset_all, \"status\": $json.status } }}",
                "options": {}
            },
            "name": "Reset Completed URLs",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                680,
                1280
            ],
            "notesInFlow": true,
            "notes": "POST /scrape/bulk/reset\n\nResets specific URL statuses:\n- Body: {\"reset_all\": false, \"status\": \"completed\"}\n- Options: \"completed\" | \"failed\" | \"processing\"\n- Changes selected status to pending\n\nEdit 'Set Reset Status Parameters' node to change status value\n\nUse when: Selective re-scraping needed"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "6-1",
                            "name": "Action",
                            "value": "Reset Completed URLs",
                            "type": "string"
                        },
                        {
                            "id": "6-2",
                            "name": "URLs Reset",
                            "value": "={{ $json.reset_count }}",
                            "type": "number"
                        },
                        {
                            "id": "6-3",
                            "name": "Message",
                            "value": "={{ $json.message }}",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Format Status Reset Output",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                900,
                1280
            ]
        },
        {
            "parameters": {},
            "name": "Sticky Note - Stop Bulk Scrape",
            "type": "n8n-nodes-base.stickyNote",
            "typeVersion": 1,
            "position": [
                460,
                1420
            ],
            "width": 300,
            "height": 120,
            "notes": "# 🛑 Stop Bulk Scrape\n\nStops currently running bulk scrape:\n- Marks task as cancelled\n- Completes current batch\n- Returns summary of progress\n\nUse when: Emergency stop needed"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://n8n-python-scraper-production.up.railway.app/scrape/bulk/stop",
                "options": {}
            },
            "name": "Stop Bulk Scrape",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                460,
                1620
            ],
            "notesInFlow": true,
            "notes": "POST /scrape/bulk/stop\n\nStops currently running bulk scrape:\n- Marks task as cancelled\n- Completes current batch before stopping\n- Returns summary of progress\n- URLs in 'processing' status will remain\n\nUse when: Emergency stop needed"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "7-1",
                            "name": "Action",
                            "value": "Stop Bulk Scrape",
                            "type": "string"
                        },
                        {
                            "id": "7-2",
                            "name": "Status",
                            "value": "={{ $json.status }}",
                            "type": "string"
                        },
                        {
                            "id": "7-3",
                            "name": "Task ID",
                            "value": "={{ $json.summary.task_id }}",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Format Stop Output",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                680,
                1620
            ]
        },
        {
            "parameters": {},
            "name": "Sticky Note - Health Check",
            "type": "n8n-nodes-base.stickyNote",
            "typeVersion": 1,
            "position": [
                460,
                1760
            ],
            "width": 300,
            "height": 120,
            "notes": "# ❤️ Health Check\n\nChecks API and browser status:\n- Service health\n- Browser warm state\n- Request count\n- Pending restarts\n\nUse when: Verifying service availability"
        },
        {
            "parameters": {
                "method": "GET",
                "url": "https://n8n-python-scraper-production.up.railway.app/health",
                "options": {}
            },
            "name": "Check API Health",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                460,
                1960
            ],
            "notesInFlow": true,
            "notes": "GET /health\n\nChecks API and browser status:\n- Service health status\n- Browser warm state (ready/not ready)\n- Total request count\n- Browser restart pending (true/false)\n\nUse when: Verifying service availability or troubleshooting"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "8-1",
                            "name": "Service Status",
                            "value": "={{ $json.status }}",
                            "type": "string"
                        },
                        {
                            "id": "8-2",
                            "name": "Browser Ready",
                            "value": "={{ $json.browser_warm ? 'Yes' : 'No' }}",
                            "type": "string"
                        },
                        {
                            "id": "8-3",
                            "name": "Request Count",
                            "value": "={{ $json.request_count }}",
                            "type": "number"
                        },
                        {
                            "id": "8-4",
                            "name": "Restart Pending",
                            "value": "={{ $json.restarts_pending ? 'Yes' : 'No' }}",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Format Health Output",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                680,
                1960
            ]
        }
    ],
