            "notes": "🔄 POST /scrape/bulk/reset\n\nResets specific status URLs\n\nBody:\n{\"reset_all\": false, \"status\": \"completed\"}\n\nOptions:\n- completed\n- failed\n- processing\n\nChange status in node settings\n\nUse when: Selective re-scrape needed"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "6-1",
                            "name": "Action",
                            "value": "Reset Completed URLs",
                            "type": "string"
