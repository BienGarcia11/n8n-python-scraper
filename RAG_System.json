        {
            "parameters": {
                "jsCode": "// Check if we have a cache hit\nconst items = $input.all();\n\n// If no items, return cache miss\nif (items.length === 0) {\n  return {\n    json: {\n      cacheHit: false,\n      similarityScore: 0\n    }\n  };\n}\n\n// n8n unwraps the response array into items. \n// We just check the first item (which should have highest similarity).\nconst firstItem = items[0].json;\n\n// Check if it's a valid row with similarity\nif (firstItem && typeof firstItem.similarity === 'number') {\n  if (firstItem.similarity >= 0.80) {\n    // Cache hit! Return the cached response\n    return {\n      json: {\n        cacheHit: true,\n        similarityScore: firstItem.similarity,\n        cachedResponse: firstItem.metadata?.response || '',\n        metadata: firstItem.metadata\n      }\n    };\n  }\n}\n\n// Cache miss or similarity too low\nreturn {\n  json: {\n    cacheHit: false,\n    similarityScore: 0\n  }\n};\n"
            },
            "id": "7d74e631-d567-42db-88cf-d361ec882041",
