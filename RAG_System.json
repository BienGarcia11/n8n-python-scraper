                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"query_embedding\": \"[{{ $('Generate Embedding').first().json.data[0].embedding.join(',') }}]\",\n  \"match_threshold\": 0.2,\n  \"match_count\": 20\n}",
