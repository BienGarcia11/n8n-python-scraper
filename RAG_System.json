            "id": "801652be-4dca-41bc-9068-09ecdcf4701d",
            "name": "Search Documents",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                992,
                1600
            ],
            "alwaysOutputData": true,
            "credentials": {
                "supabaseApi": {
                    "id": "vk4SPiG8aOpUIJxQ",
                    "name": "Supabase account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Aggregate all documents into one context string\nconst docs = $('Search Documents').all();\nconst question = $('Prepare Input').first().json.question;\nconst sessionId = $('Prepare Input').first().json.sessionId;\n\n// Format context from documents with URL metadata\nconst context = docs.length > 0 && docs[0].json && Object.keys(docs[0].json).length > 0\n  ? docs.map((item, i) => {\n      // Robust metadata extraction\n      const meta = item.json.metadata || {};\n      // Try common variations for keys\n      const url = meta.url || meta.URL || meta.link || meta.Link || meta.source || meta.Source || 'Unknown URL';\n      const title = meta.title || meta.Title || meta.name || meta.Name || `Document ${i+1}`;\n      \n      return `[Source: ${title} (${url})]\n${item.json.content || ''}`;\n    }).join('\\n\\n')\n  : 'No relevant documents found.';\n\nreturn {\n  json: {\n    context,\n    question,\n    sessionId\n  }\n};"
            },
            "id": "4cee2d46-f0bf-48e3-8f58-20bf4ab062dd",
            "name": "Format Context",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1216,
                1600
            ]
        },
        {
            "parameters": {
                "promptType": "define",
                "text": "=Context:\n{{ $json.context }}\n\nQuestion: {{ $json.question }}\n\nPlease answer the question based strictly on the context provided above. Provide a detailed answer.",
                "options": {
                    "systemMessage": "You are a helpful and precise technical support assistant for FYI Docs.\nAnswer questions based ONLY on the provided context.\n\n**Style & Formatting Rules:**\n1. **Be Direct:** Answer the question immediately. Do not use filler phrases like 'Based on the context'.\n2. **British English:** Use British spelling (e.g., 'colour', 'categorise') and date format (DD/MM/YYYY).\n3. **Citations:** At the very bottom, list unique source links used: `\\n\\n**Sources:**\\n- [Title](URL)`\n\n**Content Retrieval Rules:**\n1. **Ignore Navigation/TOCs:** The context often contains chunks that are just Tables of Contents (lists of features like 'Clients', 'Jobs', 'Reporting' with no details). **IGNORE** these lists when answering questions about 'New Features' or 'Updates'.\n2. **Focus on Detail:** Look for sections containing specific text like 'We have introduced', 'We have resolved', 'New', 'Enhancements', or '06.01.2026'.\n3. **Updates/Release Notes:**\n   - If you see a generic list of years/months (e.g. '2026 Release Notes'), ignore it.\n   - **ONLY** report the actual feature details found in the text (e.g. 'Look Up Client automation step', 'WIP Import improvements').\n   - If the *details* are missing, state: 'I found the Release Notes index, but not the detailed content.'\n4. **Categories:** If asked for categories, bullet list them."
                }
            },
